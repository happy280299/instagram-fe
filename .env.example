# Copy to .env and adjust. NEXT_PUBLIC_* values are inlined at build time: rebuild/redeploy after changing them.

# Backend origin, without /api (services add /api/...). Socket.IO connects to the same origin.
NEXT_PUBLIC_API_URL=http://localhost:3000

# This app's own URL, for link previews (metadataBase). Production: https://ig-social-clone.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001
